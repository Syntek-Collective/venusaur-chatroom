{
  "name": "venusaur-chatroom",
  "version": "1.0.0",
  "private": true,
  "description": "A real-time chat application built by a three-person team in a 10-day sprint.",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build:client": "npm ci --include=dev --prefix client && npm run build --prefix client",
    "build:server": "npm ci --include=dev --prefix server && npm run build --prefix server",
    "build": "npm run build:client && npm run build:server",
    "start": "npm start --prefix server"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syntek-Collective/venusaur-chatroom.git"
  },
  "keywords": [
    "chat",
    "real-time",
    "socket.io",
    "express",
    "react",
    "typescript",
    "mongodb",
    "stripe"
  ],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Syntek-Collective/venusaur-chatroom/issues"
  },
  "homepage": "https://github.com/Syntek-Collective/venusaur-chatroom#readme",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
